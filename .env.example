PORT=3000
XCOVER_MODE=fixture            # fixture | live
XCOVER_TIMEOUT_MS=8000         # confirm / cancel
XCOVER_OFFER_TIMEOUT_MS=3000   # create-offer: the checkout fails open after this
XCOVER_BASE_URL=https://api.xcover-staging.com/xcover/partners
XCOVER_PARTNER_CODE=E3CCM
XCOVER_SCHEMA=                 # optional; omit to use the partner default. Set only if staging returns offer_validation_schema_required
XCOVER_API_KEY=
XCOVER_API_SECRET=
XCOVER_WEBHOOK_KEY=realcheap-demo-key            # demo pair — in production, the key/secret you register with your CSE
XCOVER_WEBHOOK_SECRET=realcheap-demo-webhook-secret # any value works for the simulator; it signs and verifies with this
XCOVER_PAYMENT_PROVIDER=       # optional; a real PSP name XCover recognises (e.g. stripe). Unset = payment_details omitted (payment is simulated here)
